{
  "timeline": [
    {
      "type": "add_holds",
      "holds": ["effects"]
    },
    {
      "type": "animation",
      "animation": ["rockthrow", "rock", "physical"],
      "delay": 1.25
    },
    {
      "type": "entity_particles",
      "effect": "cobblemon:rockthrow_actor",
      "locators": ["target"],
      "targetLocators": ["target"]
    },
    {
      "type": "entity_molang",
      "entityCondition": "q.entity.is_user == true",
      "expressions": ["q.sound('move.rockthrow.actor');"]
    },
    {
      "type": "pause",
      "pause": 0.5
    },
    {
      "type": "entity_molang",
      "entityCondition": "q.entity.is_user == false && q.missed(q.entity.uuid) == false",
      "expressions": ["q.sound('move.rockthrow.target');"]
    },
    {
      "type": "remove_holds",
      "holds": ["effects"]
    },
    {
      "type": "pause",
      "pause": 1.8
    }
  ]
}