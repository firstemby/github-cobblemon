{
  "type": "cobblemon:expression",
  "order": 23,
  "expression": [
    "t.father_has_bracer = q.father.held_item.is_of('cobblemon:power_bracer');",
    "t.mother_has_bracer = q.mother.held_item.is_of('cobblemon:power_bracer');",
    "t.parent_has_bracer = t.father_has_bracer || t.mother_has_bracer;",
    "t.both_have_bracer = t.father_has_bracer && t.mother_has_bracer;",
    "t.inheritor = t.both_have_bracer ? q.random(q.father, q.mother) : (t.father_has_bracer ? q.father : q.mother);",
    "t.parent_has_bracer ? {",
    "  q.inherit(t.inheritor, 'atk');",
    "};"
  ]
}
