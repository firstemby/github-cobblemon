{
  "type": "cobblemon:expression",
  "order": 25,
  "expression": [
    "t.father_has_weight = q.father.held_item.is_of('cobblemon:power_weight');",
    "t.mother_has_weight = q.mother.held_item.is_of('cobblemon:power_weight');",
    "t.parent_has_weight = t.father_has_weight || t.mother_has_weight;",
    "t.both_have_weight = t.father_has_weight && t.mother_has_weight;",
    "t.inheritor = t.both_have_weight ? q.random(q.father, q.mother) : (t.father_has_weight ? q.father : q.mother);",
    "t.parent_has_weight ? {",
    "  q.inherit(t.inheritor, 'hp');",
    "};"
  ]
}
