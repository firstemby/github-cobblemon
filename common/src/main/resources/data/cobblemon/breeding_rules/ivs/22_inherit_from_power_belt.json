{
  "type": "cobblemon:expression",
  "order": 22,
  "expression": [
    "t.father_has_belt = q.father.held_item.is_of('cobblemon:power_belt');",
    "t.mother_has_belt = q.mother.held_item.is_of('cobblemon:power_belt');",
    "t.parent_has_belt = t.father_has_belt || t.mother_has_belt;",
    "t.both_have_belt = t.father_has_belt && t.mother_has_belt;",
    "t.inheritor = t.both_have_belt ? q.random(q.father, q.mother) : (t.father_has_belt ? q.father : q.mother);",
    "t.parent_has_belt ? {",
    "  q.inherit(t.inheritor, 'def');",
    "};"
  ]
}
