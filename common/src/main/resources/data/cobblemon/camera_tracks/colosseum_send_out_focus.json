{
  "trackId": "colosseum_send_out_focus",
  "trackType": "focus",
  "easing": "easeOutQuad",
  "keyframes": [
    {
      "time": 0.0,
      "target": {
        "type": "point",
        "position": {
          "x": { "type": "expression", "expression": "variable.send_out_position_x + (variable.send_out_position_x - variable.arena_center_x) * 0.2" },
          "y": { "type": "expression", "expression": "variable.send_out_position_y + 1.5" },
          "z": { "type": "expression", "expression": "variable.send_out_position_z + (variable.send_out_position_z - variable.arena_center_z) * 0.2" }
        }
      },
      "easing": "easeOutQuad"
    },
    {
      "time": 1.0,
      "target": {
        "type": "point",
        "position": {
          "x": { "type": "expression", "expression": "variable.send_out_position_x" },
          "y": { "type": "expression", "expression": "variable.send_out_position_y + 1" },
          "z": { "type": "expression", "expression": "variable.send_out_position_z" }
        }
      },
      "easing": "easeOutQuad"
    }
  ]
}
