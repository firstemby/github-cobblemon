{
  "version": "1.0.0",
  "collections": {
    "input": {
      "size": 1,
      "allowed_items": "minecraft:diamond"
    },
    "output": {
      "size": 1,
      "take_only": true
    }
  },
  "shift_click_rules": [
    { "from": "output", "to": "player_inventory,player_hotbar" },
    { "from": "player_inventory,player_hotbar", "to": "input" },
    { "from": "input", "to": "player_inventory,player_hotbar" }
  ],
  "on_close_items": "return",
  "actions": {
    "smelt": {
      "handler": "cobblemon:example_furnace_smelt",
      "params": []
    }
  }
}
