t.pitch = math.random(0.9, 1.05);
t.volume = 1.0;
t.depth = 2;

t.i = 0;
loop(t.depth, {
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/mud') ? return q.sound('stepsound.mud.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/sand') ? return q.sound('stepsound.sand.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/snow') ? return q.sound('stepsound.snow.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/grass') ? return q.sound('stepsound.grass.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/glass') ? return q.sound('stepsound.glass.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/dirt') ? return q.sound('stepsound.dirt.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/stone') ? return q.sound('stepsound.stone.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/wood') ? return q.sound('stepsound.wood.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/metal') ? return q.sound('stepsound.metal.standard.medium', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/leaves') ? return q.sound('stepsound.leaves.universal.medium', t.volume, t.pitch);

    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/amethyst') ?
    {
        q.sound('stepsound.amethyst.minecraft', t.volume, t.pitch);
        q.sound('stepsound.stone.standard.medium', t.volume, t.pitch);
        return 0;
    };
    t.i = t.i + 1;
});

return 0;