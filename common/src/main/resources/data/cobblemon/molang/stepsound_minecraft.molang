t.pitch = math.random(0.8, 1.0);
t.volume = 1.0;
t.depth = 2;

t.i = 0;
loop(t.depth, {
    t.i = t.i + 1;
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/mud') ? return q.sound('stepsound.mud.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/sand') ? return q.sound('stepsound.sand.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/grass') ? return q.sound('stepsound.grass.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/dirt') ? return q.sound('stepsound.dirt.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/stone') ? return q.sound('stepsound.stone.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/wood') ? return q.sound('stepsound.wood.minecraft', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/metal') ? return q.sound('stepsound.metal.minecraft', t.volume, t.pitch);
});

return 0;