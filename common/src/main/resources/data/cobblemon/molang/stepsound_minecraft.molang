t.pitch = q.random(0.80, 0.81, 0.82, 0.83, 0.84, 0.85, 0.86, 0.87, 0.88, 0.89, 0.90, 0.91, 0.92, 0.93, 0.94, 0.95, 0.96, 0.97, 0.98, 0.99, 1.0, 1.01, 1.02, 1.03, 1.04, 1.05, 1.06, 1.07, 1.08, 1.09, 1.10, 1.11, 1.12, 1.13, 1.14, 1.15, 1.16, 1.17, 1.18, 1.19, 1.20);

q.is_standing_on_blocks(2, '#cobblemon:stepsound/mud') ? q.sound('stepsound.mud.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/grass') ? q.sound('stepsound.grass.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/dirt') ? q.sound('stepsound.dirt.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/stone') ? q.sound('stepsound.stone.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/wood') ? q.sound('stepsound.wood.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/metal') ? q.sound('stepsound.metal.minecraft', t.pitch) :
q.is_standing_on_blocks(2, '#cobblemon:stepsound/sand') ? q.sound('stepsound.sand.minecraft', t.pitch);

return 0;