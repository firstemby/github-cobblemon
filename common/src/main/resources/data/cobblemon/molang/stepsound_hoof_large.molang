t.pitch = math.random(0.9, 1.05);
t.volume = 1.0;
t.depth = 2;

t.i = 0;
loop(t.depth, {
    t.i = t.i + 1;
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/mud') ? return q.sound('stepsound.mud.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/sand') ? return q.sound('stepsound.sand.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/snow') ? return q.sound('stepsound.snow.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/grass') ? return q.sound('stepsound.grass.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/dirt') ? return q.sound('stepsound.dirt.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/stone') ? return q.sound('stepsound.stone.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/wood') ? return q.sound('stepsound.wood.hoof.large', t.volume, t.pitch);
    q.is_standing_on_blocks(t.i, '#cobblemon:stepsound/metal') ? return q.sound('stepsound.metal.hoof.large', t.volume, t.pitch);
});

return 0;