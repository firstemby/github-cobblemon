{
  "version": "1.0.0",
  "mode": "overlay",
  "parameters": {
    "player_name": { "type": "string", "default": "Player" },
    "opponent_name": { "type": "string", "default": "Opponent" },
    "player_party_count": { "type": "number", "default": "6" },
    "opponent_party_count": { "type": "number", "default": "6" }
  },
  "templates": {
    "pokeball_dot": {
      "inputs": {
        "delay": { "type": "expression" },
        "color": { "type": "string" }
      },
      "type": "fill",
      "size": [8, 8],
      "color": "$color",
      "opacity": "math.clamp((q.gui_time - $delay) / 0.3, 0, 1)"
    }
  },
  "root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "top_bar": {
          "type": "fill",
          "anchor": "top_center",
          "size": ["100%", 30],
          "color": "0xFF000000",
          "opacity": "math.clamp(q.gui_time / 0.4, 0, 1)"
      }},
      { "bottom_bar": {
          "type": "fill",
          "anchor": "bottom_center",
          "size": ["100%", 30],
          "color": "0xFF000000",
          "opacity": "math.clamp(q.gui_time / 0.4, 0, 1)"
      }},
      { "player_panel": {
          "type": "fill",
          "anchor": "center_left",
          "size": ["45%", 60],
          "color": "0xCC2244AA",
          "offset": ["math.lerp(-q.screen_width, 0, math.clamp((q.gui_time - 0.2) / 0.6, 0, 1))", -10],
          "controls": [
            { "name": {
                "type": "label",
                "anchor": "center_left",
                "offset": ["math.lerp(-200, 10, math.clamp((q.gui_time - 0.8) / 2.2, 0, 1))", 0],
                "text": "q.player_name",
                "shadow": true
            }},
            { "balls": {
                "type": "list",
                "source": "q.player_party_count",
                "source_type": "count",
                "layout": "stack_horizontal",
                "spacing": 4,
                "anchor": "bottom_left",
                "offset": [10, -4],
                "item_template": {
                  "type": "pokeball_dot",
                  "delay": "0.6 + item.index * 0.15",
                  "color": "0xFFAABBFF"
                }
            }}
          ]
      }},
      { "opponent_panel": {
          "type": "fill",
          "anchor": "center_right",
          "size": ["45%", 60],
          "color": "0xCCAA2244",
          "offset": ["math.lerp(q.screen_width, 0, math.clamp((q.gui_time - 0.4) / 0.6, 0, 1))", 10],
          "controls": [
            { "name": {
                "type": "label",
                "anchor": "center_right",
                "offset": ["math.lerp(200, -10, math.clamp((q.gui_time - 1.0) / 2.2, 0, 1))", 0],
                "text": "q.opponent_name",
                "alignment": "right",
                "shadow": true
            }},
            { "balls": {
                "type": "list",
                "source": "q.opponent_party_count",
                "source_type": "count",
                "layout": "stack_horizontal",
                "spacing": 4,
                "anchor": "bottom_right",
                "offset": [-10, -4],
                "item_template": {
                  "type": "pokeball_dot",
                  "delay": "0.9 + item.index * 0.15",
                  "color": "0xFFFFAABB"
                }
            }}
          ]
      }},
      { "vs_text": {
          "type": "label",
          "anchor": "center",
          "text": "'VS'",
          "color": "0xFFFFDD44",
          "shadow": true,
          "opacity": "math.clamp((q.gui_time - 0.8) / 0.5, 0, 1)",
          "scale": "math.lerp(2.0, 1.0, math.clamp((q.gui_time - 0.8) / 0.5, 0, 1))"
      }},
      { "player_accent": {
          "type": "fill",
          "anchor": "top_left",
          "offset": [0, 30],
          "size": ["45%", 2],
          "color": "0xFF4466FF",
          "opacity": "math.clamp((q.gui_time - 0.2) / 0.6, 0, 1)"
      }},
      { "opponent_accent": {
          "type": "fill",
          "anchor": "bottom_right",
          "offset": [0, -30],
          "size": ["45%", 2],
          "color": "0xFFFF4466",
          "opacity": "math.clamp((q.gui_time - 0.4) / 0.6, 0, 1)"
      }}
    ]
  }
}
