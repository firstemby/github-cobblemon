{
  "version": "1.0.0",
  "mode": "screen",
  "parameters": {
    "shop_items": { "type": "string", "default": "[]" },
    "emerald_count": { "type": "string", "default": "0" },
    "selected_item_name": { "type": "string", "default": "" },
    "selected_entry_type": { "type": "string", "default": "item" },
    "selected_species": { "type": "string", "default": "" },
    "selected_item_id": { "type": "string", "default": "" }
  },
  "variables": {
    "v.page": 0,
    "v.selected_index": -1,
    "v.quantity": 1,
    "v.unit_price": 0
  },
  "root": {
    "type": "panel",
    "anchor": "center",
    "size": [220, 180],
    "controls": [
      { "bg": { "type": "fill", "size": ["100%", "100%"], "color": "0xDD1a1a2e" } },

      { "list_page": {
        "type": "panel",
        "size": ["100%", "100%"],
        "visible": "v.page == 0",
        "controls": [
          { "header": {
            "type": "panel",
            "size": ["100%", 20],
            "controls": [
              { "title": {
                "type": "label",
                "anchor": "center_left",
                "offset": [8, 0],
                "text": "Shop",
                "color": "0xFF88FF88"
              }},
              { "emeralds": {
                "type": "label",
                "anchor": "center_right",
                "offset": [-8, 0],
                "size": [100, 10],
                "text": "'Emeralds: ' + q.to_string(q.emerald_count)",
                "alignment": "right",
                "color": "0xFF55FF55"
              }}
            ]
          }},
          { "divider": { "type": "fill", "anchor": "top_left", "offset": [4, 20], "size": ["100% - 8", 1], "color": "0xFF333355" } },
          { "item_scroll": {
            "type": "scroll_panel",
            "anchor": "top_left",
            "offset": [4, 24],
            "size": ["100% - 8", "100% - 28"],
            "controls": [
              { "item_list": {
                "type": "list",
                "source_type": "data",
                "source": "q.shop_items",
                "layout": "stack_vertical",
                "spacing": 2,
                "size": ["100%", "100%"],
                "item_template": {
                  "type": "panel",
                  "size": ["100%", 24],
                  "on_click_client": "q.send_action('select_item', q.item.index)",
                  "controls": [
                    { "item_bg": { "type": "fill", "size": ["100%", "100%"], "color": "0xFF222244" } },
                    { "mc_item_icon": {
                      "type": "item_slot",
                      "anchor": "center_left",
                      "offset": [3, 0],
                      "size": [16, 16],
                      "item": "q.item.item_id",
                      "visible": "q.item.entry_type == 'item'"
                    }},
                    { "pokemon_icon": {
                      "type": "pokemon_render",
                      "anchor": "center_left",
                      "offset": [2, 0],
                      "size": [20, 20],
                      "species": "q.item.species",
                      "scale": 0.5,
                      "visible": "q.item.entry_type == 'pokemon'"
                    }},
                    { "item_name": {
                      "type": "label",
                      "anchor": "center_left",
                      "offset": [24, 0],
                      "text": "q.item.name"
                    }},
                    { "item_price": {
                      "type": "label",
                      "anchor": "center_right",
                      "offset": [-6, 0],
                      "size": [60, 10],
                      "text": "'E ' + q.item.price",
                      "alignment": "right",
                      "color": "0xFF55FF55"
                    }}
                  ]
                }
              }}
            ]
          }}
        ]
      }},

      { "purchase_page": {
        "type": "panel",
        "size": ["100%", "100%"],
        "visible": "v.page == 1",
        "controls": [
          { "back_btn": {
            "type": "button",
            "anchor": "top_left",
            "offset": [4, 4],
            "size": [40, 16],
            "text": "Back",
            "color": "0xFF444466",
            "on_click_client": "q.send_action('back')"
          }},
          { "card_bg": {
            "type": "fill",
            "anchor": "center",
            "offset": [0, -5],
            "size": [160, 140],
            "color": "0xFF222244"
          }},
          { "pokemon_preview": {
            "type": "pokemon_render",
            "anchor": "top_center",
            "offset": [0, 24],
            "size": [60, 50],
            "species": "q.selected_species",
            "scale": 1.4,
            "visible": "q.selected_entry_type == 'pokemon'"
          }},
          { "item_title": {
            "type": "label",
            "anchor": "top_center",
            "offset": [0, 78],
            "text": "q.selected_item_name",
            "alignment": "center",
            "color": "0xFFFFFFFF",
            "visible": "q.selected_entry_type == 'pokemon'"
          }},
          { "item_title_mc": {
            "type": "label",
            "anchor": "top_center",
            "offset": [0, 30],
            "text": "q.selected_item_name",
            "alignment": "center",
            "color": "0xFFFFFFFF",
            "visible": "q.selected_entry_type == 'item'"
          }},
          { "unit_price_label": {
            "type": "label",
            "anchor": "top_center",
            "offset": [0, 93],
            "text": "'Unit price: E ' + q.to_string(v.unit_price)",
            "alignment": "center",
            "color": "0xFF888888"
          }},
          { "quantity_input": {
            "type": "number_input",
            "anchor": "center",
            "offset": [0, -15],
            "size": [100, 20],
            "value": "v.quantity",
            "min": 1,
            "max": 64,
            "step": 1,
            "variable": "v.quantity",
            "button_color": "0xFF444466"
          }},
          { "total_label": {
            "type": "label",
            "anchor": "center",
            "offset": [0, 10],
            "text": "'Total: E ' + q.to_string(v.quantity * v.unit_price)",
            "alignment": "center",
            "color": "0xFF55FF55"
          }},
          { "balance_label": {
            "type": "label",
            "anchor": "center",
            "offset": [0, 25],
            "text": "'You have: E ' + q.to_string(v.emerald_count)",
            "alignment": "center",
            "color": "0xFFAAAAAA"
          }},
          { "purchase_btn": {
            "type": "button",
            "anchor": "center",
            "offset": [0, 45],
            "size": [100, 20],
            "text": "Purchase",
            "color": "0xFF2a5a2a",
            "on_click_client": "q.send_action('purchase', v.selected_index, v.quantity)"
          }}
        ]
      }}
    ]
  }
}
