{
  "multipart": [
    {
      "when": { "modified": "false", "facing": "south" },
      "apply": { "model": "cobblemon:block/display_case" }
    },
    {
      "when": { "modified": "false", "facing": "west" },
      "apply": { "model": "cobblemon:block/display_case", "y": 90 }
    },
    {
      "when": { "modified": "false", "facing": "north" },
      "apply": { "model": "cobblemon:block/display_case", "y": 180 }
    },
    {
      "when": { "modified": "false", "facing": "east" },
      "apply": { "model": "cobblemon:block/display_case", "y": 270 }
    }
  ]
}