{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:battle_snow",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/weather/battle_snow"
			}
		},
		"curves": {
			"variable.sway": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [-1, 1, -1, 1, -1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 600
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1,
				"expiration_expression": "q.is_weather_active == 0"
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "event_snow_dust"
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, "math.random(1,32)", 0],
				"radius": 16,
				"direction": ["math.random(-1,1)", -2, "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 6
			},
			"minecraft:particle_initial_speed": "math.random(1,2)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["variable.sway + math.random(-1,1)", "v.particle_random_1 * math.random(-4,4)", 0],
				"linear_drag_coefficient": 0.05
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "rotate_y",
				"uv": {
					"texture_width": 16,
					"texture_height": 4,
					"uv": ["math.floor(variable.particle_random_2 * 4) * 4", 0],
					"uv_size": [4, 4]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.05,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age / v.particle_lifetime)",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.26": "#ffffffff",
						"0.77": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}