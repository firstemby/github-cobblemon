{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:battle_rain",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/weather/battle_rain"
			}
		},
		"events": {
			"event_splash": {
				"particle_effect": {
					"effect": "cobblemon:battle_splash",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 300,
				"max_particles": 600
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1,
				"expiration_expression": "q.is_weather_active == 0"
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 32, 0],
				"radius": 16,
				"direction": ["v.particle_random_1 * -v.particle_random_1", -1, "v.particle_random_1 * -v.particle_random_1"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_lifetime_events": {
				"expiration_event": ["event_splash", "event_smoke"]
			},
			"minecraft:particle_initial_speed": 8,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -32, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.2, 0.5],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.48": "#ffffffff",
						"1.0": "#FFFFFFFF"
					}
				}
			}
		}
	}
}