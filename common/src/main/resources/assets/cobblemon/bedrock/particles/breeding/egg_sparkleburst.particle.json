{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:egg_sparkleburst",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/glowing_sparkle_yellow"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "10 * math.clamp(q.entity_size,1.5,3)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "0.5 * math.clamp(q.entity_size,1,2)"
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.5, 0],
				"radius": 0.5,
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.25,1.25)"
			},
			"minecraft:particle_initial_speed": "math.clamp(q.entity_size*9, 9, 27 )",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["v.particle_random_1*12 - 6", "v.particle_random_2*12 - 6", "v.particle_random_3*12 - 6"],
				"linear_drag_coefficient": "5.5-math.clamp(((q.entity_size-1)/2),0, 1.5)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.0625 * math.clamp(q.entity_size,1,2) + 0.1", "0.0625 * math.clamp(q.entity_size,1,2) + 0.1"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 32,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [0, 8],
						"frames_per_second": 30,
						"max_frame": 4,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 5,
				"collision_radius": 0.05
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.22": "#FFFFEC2E",
						"0.56": "#FFFF6CAF",
						"0.77": "#FFFFA9F1",
						"1.0": "#FFFFB786"
					}
				}
			}
		}
	}
}