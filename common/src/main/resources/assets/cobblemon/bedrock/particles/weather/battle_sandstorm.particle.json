{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:battle_sandstorm",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/weather/battle_sand"
      }
    },
    "curves": {
      "variable.sway": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [-1, 1, -1, 1, -1]
      }
    },
    "events": {
      "event_dust": {
        "particle_effect": {
          "effect": "cobblemon:battle_sandstorm_dust",
          "type": "particle"
        }
      },
      "event_obscure": {
        "particle_effect": {
          "effect": "cobblemon:battle_sandstorm_obscure",
          "type": "particle"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 200,
        "max_particles": 600
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": "q.is_weather_active == 0"
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": ["event_dust", "event_obscure"]
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [-10, "math.random(0,8)", 0],
        "radius": 8,
        "direction": [6, -0.2, "math.random(-1,1)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random_integer(1,4)*90"
      },
      "minecraft:particle_initial_speed": "math.random(16,32)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["variable.sway + math.random(-1,1)", "-v.particle_random_1 * math.random(10,21)", 0],
        "linear_drag_coefficient": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.6, 0.6],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "uv": [0, "math.floor(variable.particle_random_2 * 4) * 8"],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.18": "#FFFFFFFF",
            "0.82": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}